# Example environment variables

# port number for the server to listen on
PORT=3000

# environment the application is running in (development, production, etc.)
NODE_ENV=production

# server API key for authentication
SERVER_API_KEY=your_secure_api_key_here

# allowed origin for CORS requests
ALLOWED_ORIGIN=http://localhost:3000

# logging level for the application (debug, info, warn, error)
LOG_LEVEL=info

# projects directory path for storing project files
PROJECTS_DIR=/var/www